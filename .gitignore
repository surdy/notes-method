# Rust
target/
crates/notesmith-tauri/gen/

# Tauri sidecar binaries (built, not committed)
crates/notesmith-tauri/binaries/notesmith-*

# Bundled embedding model weights (fetched, not committed — see fetch-embed-model.sh).
# Keep the tracked README so the Tauri resource glob matches without a download.
crates/notesmith-tauri/resources/embed-model/*
!crates/notesmith-tauri/resources/embed-model/README.md

# Bundled whisper transcription model weights (fetched, not committed — see fetch-whisper-model.sh).
# Keep the tracked README so the Tauri resource glob matches without a download.
crates/notesmith-tauri/resources/whisper-model/*
!crates/notesmith-tauri/resources/whisper-model/README.md

# Tauri-build autogenerated user-command permissions (from build.rs AppManifest)
crates/notesmith-tauri/permissions/autogenerated/

# Node / SvelteKit
node_modules/
ui/app/.svelte-kit/
ui/app/build/
test-results/

# OS
.DS_Store
