{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri/schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "startup-splash", "startup-fallback"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "deep-link:default",
    "allow-retry-daemon-connect",
    "allow-open-diagnostics",
    "allow-quit-app",
    "allow-restart-app",
    "allow-view-crash-report",
    "allow-restart-daemon-anyway",
    "allow-open-vault-window",
    "allow-set-window-title",
    "allow-confirm-window-close",
    "allow-open-folder-as-vault",
    "allow-list-open-vaults",
    "allow-close-vault-window",
    "allow-pick-vault-folder",
    "allow-agent-start",
    "allow-agent-send",
    "allow-agent-stop",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/notesmith",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/notesmith",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
