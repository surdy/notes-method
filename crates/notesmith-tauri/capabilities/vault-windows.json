{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri/schema.json",
  "identifier": "vault-windows",
  "description": "Capability granted to every per-vault window (main:*).",
  "windows": ["main:*"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "allow-open-vault-window",
    "allow-set-window-title",
    "allow-confirm-window-close",
    "allow-open-folder-as-vault",
    "allow-list-open-vaults",
    "allow-close-vault-window",
    "allow-pick-vault-folder",
    "allow-agent-start",
    "allow-agent-send",
    "allow-agent-stop"
  ]
}
