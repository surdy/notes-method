{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri/schema.json",
  "identifier": "vault-windows",
  "description": "Capability granted to every per-vault window (main:*).",
  "windows": ["main:*"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "allow-open-vault-window",
    "allow-set-window-title",
    "allow-confirm-window-close",
    "allow-open-folder-as-vault",
    "allow-list-open-vaults",
    "allow-close-vault-window",
    "allow-pick-vault-folder",
    "allow-agent-list",
    "allow-agent-start",
    "allow-agent-prompt",
    "allow-agent-select-model",
    "allow-agent-set-read-only",
    "allow-agent-answer-permission",
    "allow-agent-stop",
    "allow-agent-config-get",
    "allow-agent-config-set",
    "allow-agent-diagnostics",
    "allow-agent-diagnostics-log",
    "allow-agent-diagnostics-set-verbose",
    "allow-agent-diagnostics-clear",
    "allow-mcp-servers-get",
    "allow-mcp-servers-set",
    "allow-connection-list",
    "allow-connection-add",
    "allow-connection-update",
    "allow-connection-remove",
    "allow-connection-set-active",
    "allow-connection-test",
    "allow-refresh-remote-vaults",
    "allow-window-connection-info"
  ]
}
