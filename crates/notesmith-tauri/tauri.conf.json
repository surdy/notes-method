{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Notesmith",
  "version": "0.1.0",
  "identifier": "com.notesmith.desktop",
  "mainBinaryName": "notesmith-desktop",
  "build": {
    "frontendDist": "../../ui/app/build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Notesmith",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "url": "http://127.0.0.1:27183/app/",
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/notesmith"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["notesmith"]
      }
    }
  }
}
